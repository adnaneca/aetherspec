# Web UI build-time config
# For LOCAL DEV on Oracle VM:
VITE_APP_THEME=tomorrow-night-blue
VITE_GATEWAY_API_URL=http://localhost:3000
VITE_GATEWAY_WS_URL=ws://localhost:3000
VITE_KEYCLOAK_URL=https://auth.aetherspec.ai
VITE_KEYCLOAK_REALM=aetherspec
VITE_KEYCLOAK_CLIENT_ID=aetherspec-web

