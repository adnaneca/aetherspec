# Gateway
# NOTE: Port 3000 matches the existing nginx config for api.aetherspec.ai
# which proxies to 127.0.0.1:3000. Do NOT change this without updating nginx.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
GATEWAY_ENV=development
GATEWAY_LOG_LEVEL=info

# Keycloak (served via HTTPS at auth.aetherspec.ai by nginx)
KEYCLOAK_URL=https://auth.aetherspec.ai
KEYCLOAK_REALM=aetherspec
KEYCLOAK_JWKS_URL=https://auth.aetherspec.ai/realms/aetherspec/protocol/openid-connect/certs

# Mastra Agent Sidecar (runs on same host, localhost)
AGENT_GRPC_URL=localhost:50051

# Postgres (Docker container on server, bound to 127.0.0.1:5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=appuser
POSTGRES_PASSWORD=FCv15sOanqM8soeO01lbV68xigtO6CL3
POSTGRES_SSLMODE=disable

# MinIO (Docker container on server, bound to 127.0.0.1:9000)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=508cd3c3fcf885fc
MINIO_SECRET_KEY=6l2oelxAPPSzgIcqDXWdwSNwjFqDGzb7
MINIO_USE_SSL=false
MINIO_BUCKET=aetherspec-artifacts

# OpenTelemetry / Langfuse
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme
