# Agent Sidecar
AGENT_PORT=50051
AGENT_ENV=development
AGENT_LOG_LEVEL=info

# Ollama Cloud (OpenAI-compatible endpoint)
# NOTE: No Bifrost gateway. Mastra calls Ollama Cloud directly.
OLLAMA_BASE_URL=https://api.ollama.cloud/v1
OLLAMA_API_KEY=changeme
OLLAMA_MODEL=llama3.1:70b

# Postgres (Docker container on server, bound to 127.0.0.1:5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aetherspec
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_SSLMODE=disable

# MinIO (Docker container on server, bound to 127.0.0.1:9000)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_BUCKET=aetherspec-artifacts

# Langfuse observability
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme
