# ========================================
# AetherSpec Production Environment
# ========================================
# Copy this file to .env.prod and fill in real credentials
# DO NOT commit .env.prod to git!

# ========================================
# Gateway Configuration
# ========================================
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
GATEWAY_ENV=production
GATEWAY_LOG_LEVEL=info

# ========================================
# Keycloak (HTTPS via nginx)
# ========================================
KEYCLOAK_URL=https://auth.aetherspec.ai
KEYCLOAK_REALM=aetherspec
KEYCLOAK_JWKS_URL=https://auth.aetherspec.ai/realms/aetherspec/protocol/openid-connect/certs

# ========================================
# Agent Sidecar
# ========================================
AGENT_GRPC_URL=localhost:50051

# ========================================
# PostgreSQL (Docker container)
# ========================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aetherspec
POSTGRES_USER=aetherspec
POSTGRES_PASSWORD=<REPLACE_WITH_REAL_PASSWORD>
POSTGRES_SSLMODE=disable

# ========================================
# MinIO (Docker container)
# ========================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<REPLACE_WITH_REAL_ACCESS_KEY>
MINIO_SECRET_KEY=<REPLACE_WITH_REAL_SECRET_KEY>
MINIO_USE_SSL=false
MINIO_BUCKET=aetherspec-artifacts

# ========================================
# Ollama Cloud (AI Provider)
# ========================================
OLLAMA_BASE_URL=https://api.ollama.cloud/v1
OLLAMA_API_KEY=<REPLACE_WITH_YOUR_OLLAMA_API_KEY>
OLLAMA_MODEL=llama3.1:70b

# ========================================
# Langfuse (Observability)
# ========================================
LANGFUSE_HOST=https://langfuse.aetherspec.ai
LANGFUSE_PUBLIC_KEY=<REPLACE_WITH_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<REPLACE_WITH_SECRET_KEY>
