# AetherSpec Agent Production Environment
AGENT_PORT=50051
AGENT_ENV=production
AGENT_LOG_LEVEL=info

OLLAMA_BASE_URL=https://api.ollama.cloud/v1
OLLAMA_API_KEY=<REPLACE_WITH_YOUR_OLLAMA_API_KEY>
OLLAMA_MODEL=llama3.1:70b

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aetherspec
POSTGRES_USER=aetherspec
POSTGRES_PASSWORD=changeme
POSTGRES_SSLMODE=disable

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_BUCKET=aetherspec-artifacts

LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme
